{
  "name": "timeglass",
  "version": "0.0.1",
  "description": "AI subscription usage and billing across vendors and accounts: CLI + GNOME top-bar",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "bin": {
    "timeglass": "./dist/cjs/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guilhermegor/timeglass.git"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0",
    "npm": ">=11.15.0"
  },
  "packageManager": "npm@11.15.0",
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "tsc -p tsconfig.esm.json",
    "postbuild:esm": "bash bin/write_esm_package_json.sh",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:types": "tsc -p tsconfig.types.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ext .ts --report-unused-disable-directives",
    "lint:fix": "eslint . --ext .ts --fix",
    "lint:css": "echo 'ts-lib ships no CSS — nothing to lint'",
    "lint:readme": "bash bin/check_readme_structure.sh README.md",
    "test": "jest",
    "test:watch": "jest --watch",
    "prepublishOnly": "npm run build",
    "pack:smoke": "bash bin/smoke_pack.sh",
    "docs:start": "docusaurus start",
    "docs:build": "docusaurus build --out-dir docs-build",
    "docs:version": "docusaurus docs:version",
    "context:export": "bash bin/export_repo_content.sh"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@docusaurus/core": "^3.6.0",
    "@docusaurus/preset-classic": "^3.6.0",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "babel-jest": "^30.4.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.0.0",
    "jest": "^30.4.2",
    "jest-environment-node": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.2"
  },
  "overrides": {
    "tinypool": "^2.1.2",
    "serialize-javascript": "^7.0.5",
    "uuid": "^11.1.1",
    "postcss-selector-parser": "^7.1.6"
  }
}
